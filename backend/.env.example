# ============================================================================
# Configuração de Ambiente e Segurança - Patas & Ponto (OWASP Best Practices)
# Copie este arquivo para .env e defina os segredos antes de subir em produção
# ============================================================================
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Origens permitidas no CORS e proteção Anti-CSRF (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,http://127.0.0.1:3001

# Credenciais Administrativas (NUNCA salve a senha em texto puro; use hash bcrypt custo >= 12)
# Gere um novo hash com: node -e "import('bcryptjs').then(b => console.log(b.default.hashSync('SuaSenhaForte', 12)))"
ADMIN_EMAIL=miauartesanatos@gmail.com
ADMIN_PASSWORD_HASH=$2b$12$LyFynvVk9TWrkhC7AHzm7OtisGScpt05mvNXJpiTmlDRhEH1g3rVi

# Segurança de Sessão e Proxy
COOKIE_SECURE=false
TRUST_PROXY=loopback

# Políticas de Menor Privilégio no Painel Admin
ADMIN_SQL_ALLOW_WRITE=false
ALLOW_DB_SWITCH=false
AUTO_CUSTOMERS=true

# Configuração opcional de Servidor PostgreSQL Externo
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=miau_artesanatos
# DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/miau_artesanatos
